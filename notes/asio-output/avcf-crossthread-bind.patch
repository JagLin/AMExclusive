+// Observer-only: AVCF local-file graphs bind a same-rate LPCM converter that
+// never reaches the FillComplexBuffer capture path. These record whether Apple
+// drives converters through the older entry points; they never alter data.
+AppleOSStatus __cdecl HookV2AudioConverterConvertBuffer(void* converter, std::uint32_t inputSize,
+                                                        const void* input,
+                                                        std::uint32_t* outputSize,
+                                                        void* output) {
+    const auto requested = outputSize ? *outputSize : 0u;
+    const auto result = g_v2OriginalAudioConverterConvertBuffer
+        ? g_v2OriginalAudioConverterConvertBuffer(converter, inputSize, input, outputSize, output)
+        : -1;
+    if (g_convertBufferLogBudget.fetch_sub(1, std::memory_order_relaxed) > 0) {
+        Log(L"diag AudioConverterConvertBuffer converter=" +
+            std::to_wstring(reinterpret_cast<std::uintptr_t>(converter)) +
+            L" localQueue=" + std::to_wstring(FindV2LocalQueue(converter) != nullptr) +
+            L" bound=" + std::to_wstring(g_audioCoreRuntime.IsConverterBound(converter)) +
+            L" inputBytes=" + std::to_wstring(inputSize) +
+            L" outputRequested=" + std::to_wstring(requested) +
+            L" outputWritten=" + std::to_wstring(outputSize ? *outputSize : 0u) +
+            L" result=" + std::to_wstring(result));
+    }
+    return result;
+}
