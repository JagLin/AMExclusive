+bool AudioCoreRuntime::DescribeConverter(void* converter, std::uint32_t& sampleRate,
+                                         std::uint32_t& channels,
+                                         std::uint32_t& sourceBitDepth,
+                                         std::uint64_t& observationId) const noexcept {
+    ConverterRegistrationSnapshot snapshot{};
+    if (!converter || !registry_.Snapshot(converter, snapshot)) return false;
+    sampleRate = snapshot.registration.outputFormat.sampleRate;
